<?xml version="1.0" encoding="utf-8"?> 
<image schemaversion="7.4" name="Fedora">
	<description type="system">
		<author>zearp</author>
		<contact>https://github.com/zearp/pumice-fedora</contact>
		<specification>Fedora Linux 44</specification>
	</description>
	<preferences>
		<version>44</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_GB</locale>
		<keytable>us</keytable>
		<timezone>Europe/Amsterdam</timezone>
		<release-version>44</release-version>
	</preferences>
	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="fedora-cisco-openh264" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-cisco-openh264-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-free" sourcetype="mirrorlist">
		<source path="https://mirrors.rpmfusion.org/mirrorlist?repo=free-fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-2020"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-free-updates" sourcetype="mirrorlist">
		<source path="https://mirrors.rpmfusion.org/mirrorlist?repo=free-fedora-updates-released-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-2020"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-nonfree" sourcetype="mirrorlist">
		<source path="https://mirrors.rpmfusion.org/mirrorlist?repo=nonfree-fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-nonfree-updates" sourcetype="mirrorlist">
		<source path="https://mirrors.rpmfusion.org/mirrorlist?repo=nonfree-fedora-updates-released-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020"/>
		</source>
	</repository>
	<profiles>
		<profile name="Pumice" description="Fedora Linux"></profile>
	</profiles>
	<packages type="image" patternType="plusRecommended" profiles="Pumice">
		<file name="iso-esp-excludes.yaml" target="image/exclude_files_efifatimage.yaml"/>
		<!-- groups to install, see "dnf group list" and "https://dnf.readthedocs.io/en/latest/command_ref.html" for more info -->
		<namedCollection name="anaconda-tools"/>
		<namedCollection name="core"/>
		<namedCollection name="fonts"/>
		<namedCollection name="hardware-support"/>
		<namedCollection name="multimedia"/>
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="standard"/>
<!--		<namedCollection name="guest-desktop-agents"/> -->
<!--		<namedCollection name="workstation-product-environment"/> -->
		<!-- packages to ignore/make sure are not installed -->
		<ignore name="device-mapper-multipath"/>
		<ignore name="arm-trusted-firmware-armv8"/>
		<ignore name="edk2-aarch64"/>
		<ignore name="fwupd"/>
		<ignore name="fwupd-*"/>
		<ignore name="fcoe-utils"/>
		<ignore name="gfs2-utils"/>
		<ignore name="gnome-initial-setup"/>
		<ignore name="gnome-tour"/>
		<ignore name="grub2-efi-ia32"/>
		<ignore name="grub2-efi-ia32-cdboot"/>
		<ignore name="kdump-utils"/>
		<ignore name="kernel-*debug*"/>
		<ignore name="malcontent-control"/>
		<ignore name="PackageKit-command-not-found"/>
		<ignore name="python3-boto3"/>
		<ignore name="qemu-user-static"/>
		<ignore name="shim-ia32"/>
		<ignore name="uboot-images-armv8"/>
		<ignore name="uboot-tools"/>
		<!-- packages, be careful when removing as some packages are required by the installer -->
		<package name="aajohan-comfortaa-fonts"/>
		<package name="amd-ucode-firmware"/>
		<package name="anaconda"/>
		<package name="anaconda-install-env-deps"/>
		<package name="anaconda-live"/>
		<package name="bat"/>
		<package name="btop"/>
		<package name="cockpit"/>
		<package name="cockpit-files"/>
		<package name="cockpit-packagekit"/>
		<package name="cockpit-selinux"/>
		<package name="cockpit-storaged"/>
		<package name="dbus-daemon"/>
		<package name="dconf-editor"/>
		<package name="ddcutil"/>
		<package name="dialog"/>
		<package name="dracut-live"/>
		<package name="drm_info"/>
		<package name="eza"/>
		<package name="fastfetch"/>
		<package name="firefox"/>
		<package name="flatseal"/>
		<package name="gamemode"/>
		<package name="git"/>
		<package name="git-lfs"/>
		<package name="gnome-bluetooth"/>
		<package name="gnome-browser-connector"/>
		<package name="gnome-clocks"/>
		<package name="gnome-control-center"/>
		<package name="gnome-disk-utility"/>
		<package name="gnome-extensions-app"/>
		<package name="gnome-keyring"/>
		<package name="gnome-session-wayland-session"/>
		<package name="gnome-shell-extension-appindicator"/>
		<package name="gnome-shell-extension-blur-my-shell"/>
		<package name="gnome-shell-extension-caffeine"/>
		<package name="gnome-shell-extension-dash-to-dock"/>
		<package name="gnome-shell-extension-gamemode"/>
		<package name="gnome-shell-extension-just-perfection"/>
		<!-- package below is only needed because the option to hide 
		the overview is broken in both dash to dock and just perfection -->
		<package name="gnome-shell-extension-no-overview"/>
<!--		<package name="gnome-software"/> -->
		<package name="gnome-text-editor"/>
		<package name="gnome-tweaks"/>
		<package name="gnome-weather"/>
		<package name="grub2-efi-x64-modules"/>
		<package name="grub2-pc-modules"/>
		<package name="grubby"/>
		<package name="gstreamer1-plugin-openh264"/>
		<package name="hddtemp"/>
		<package name="htop"/>
		<package name="igt-gpu-tools"/>
		<package name="ipcalc"/>
		<package name="iperf3"/>
		<package name="isomd5sum"/>
		<package name="kernel"/>
		<package name="kernel-core"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="libva-utils"/>
		<package name="livesys-scripts"/>
		<package name="lm_sensors"/>
		<package name="loupe"/>
		<package name="mc"/>
		<package name="mesa-vulkan-drivers"/>
		<package name="microcode_ctl"/>
		<package name="mpv"/>
		<package name="mozilla-openh264"/>
		<package name="nano"/>
		<package name="nautilus"/>
		<package name="ncdu"/>
		<package name="NetworkManager-config-connectivity-fedora"/>
		<package name="NetworkManager-tui"/>
		<package name="ntsync-autoload"/>
		<package name="nvtop"/>
		<package name="papers"/>
		<package name="pcp"/>
		<package name="perl-Image-ExifTool"/>
		<package name="python3-pcp"/>
		<package name="plymouth-system-theme"/>
		<package name="power-profiles-daemon"/>
		<package name="ptyxis"/>
		<package name="radeontop"/>
		<package name="ripgrep"/>
		<package name="screen"/>
		<package name="seahorse"/>
		<package name="selinux-policy"/>
		<package name="setroubleshoot-server"/>
		<package name="shim-signed-x64"/>
		<package name="snapper"/>
		<package name="stress-ng"/>
		<package name="telnet"/>
		<package name="thermald"/>
		<package name="tio"/>
		<package name="udisks2-btrfs"/>
		<package name="vulkan-tools"/>
		<package name="wavemon"/>
		<package name="yt-dlp"/>
		<package name="zram-generator"/>
		<package name="zsh"/>
		<package name="zsh-autosuggestions"/>
		<package name="zsh-syntax-highlighting"/>
	</packages>
	<preferences profiles="Pumice" arch="x86_64">
		<type image="iso"
			publisher="Fedora Project" volid="Fedora_Linux" application_id="Fedora_Linux"
			primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=9" mediacheck="true"
			firmware="uefi" efiparttable="gpt" efifatimagesize="30"
			kernelcmdline="quiet rhgb intel_iommu=on amd_iommu=on iommu=pt inst.kdump_addon=off thunderbolt.host_reset=false biosdevname=0 net.ifnames=0 inst.geoloc=0"
			bundle_format="Pumice-Fedora-%v-%A" fscreateoptions="--workers=NPROC_PLACEHOLDER -Efragments -C 1048576"
			>
			<bootloader name="grub2" grub_template="grub-x86.cfg.iso-template" console="console" timeout="10"/>
		</type>
	</preferences>
	<packages type="bootstrap">
		<package name="basesystem"/>
<!--		<package name="fedora-release-workstation"/> -->
		<package name="filesystem"/>
	</packages>
	<users profiles="Pumice">
		<!-- password will be erased in config.sh -->
		<user name="root" groups="root" password="root" home="/root" pwdformat="plain" />
	</users>
</image>
